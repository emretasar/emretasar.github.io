---
import { siteConfig } from '../lib/site';
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-stone-200 dark:border-zinc-800">
  <div class="mx-auto flex max-w-3xl flex-col gap-3 px-5 py-8 text-sm text-stone-500 sm:flex-row sm:items-center sm:justify-between sm:px-6 dark:text-zinc-400">
    <p>© {year} {siteConfig.name}.</p>
    <div class="flex gap-4">
      <a class="hover:text-stone-950 dark:hover:text-zinc-50" href={siteConfig.links.github}>GitHub</a>
      <a class="hover:text-stone-950 dark:hover:text-zinc-50" href={siteConfig.links.linkedin}>LinkedIn</a>
      <a class="hover:text-stone-950 dark:hover:text-zinc-50" href={`mailto:${siteConfig.email}`}>Email</a>
    </div>
  </div>
</footer>

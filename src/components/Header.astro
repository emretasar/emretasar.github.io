---
import { navigation, siteConfig } from '../lib/site';
import ThemeToggle from './ThemeToggle.astro';

const { pathname } = Astro.url;
---

<header class="border-b border-stone-200 dark:border-zinc-800">
  <div class="mx-auto flex max-w-3xl items-center justify-between px-5 py-5 sm:px-6">
    <a href="/" class="font-semibold tracking-tight no-underline">{siteConfig.name}</a>
    <div class="flex items-center gap-1 sm:gap-3">
      <nav aria-label="Main navigation">
        <ul class="flex items-center gap-1 sm:gap-3">
          {navigation.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={pathname === item.href ? 'page' : undefined}
                class:list={[
                  'rounded px-2 py-1 text-sm no-underline transition-colors',
                  pathname === item.href
                    ? 'text-stone-950 dark:text-zinc-50'
                    : 'text-stone-500 hover:text-stone-950 dark:text-zinc-400 dark:hover:text-zinc-50',
                ]}
              >{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>

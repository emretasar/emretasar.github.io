---
interface Props {
  title: string;
  description: string;
  technologies: string[];
  href?: string;
}

const { title, description, technologies, href } = Astro.props;
---

<article class="rounded-lg border border-stone-200 p-5 dark:border-zinc-800">
  <h3 class="font-semibold tracking-tight text-stone-950 dark:text-zinc-50">
    {href ? <a class="hover:underline" href={href}>{title}</a> : title}
  </h3>
  <p class="mt-2 text-sm leading-6 text-stone-600 dark:text-zinc-400">{description}</p>
  <ul class="mt-4 flex flex-wrap gap-x-3 gap-y-1 text-xs text-stone-500 dark:text-zinc-500" aria-label="Technologies used">
    {technologies.map((technology) => <li>{technology}</li>)}
  </ul>
</article>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostMeta from '../../components/PostMeta.astro';
import { getPublishedPosts } from '../../lib/blog';

const posts = await getPublishedPosts();
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<BaseLayout title="Blog" description="Notes on C++, embedded systems, Qt/QML, and software engineering.">
  <section>
    <p class="font-mono text-sm text-stone-500 dark:text-zinc-400">Writing</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight text-stone-950 dark:text-zinc-50">Technical notes and working thoughts.</h1>
    <p class="mt-5 max-w-2xl text-lg text-stone-600 dark:text-zinc-400">A place for lessons from C++, embedded development, Qt/QML, and my path into software engineering.</p>
    {tags.length > 0 && (
      <ul class="mt-7 flex flex-wrap gap-2" aria-label="Post topics">
        {tags.map((tag) => <li class="rounded-full border border-stone-200 px-3 py-1 text-xs text-stone-600 dark:border-zinc-800 dark:text-zinc-400">{tag}</li>)}
      </ul>
    )}
  </section>

  <div class="mt-12 divide-y divide-stone-200 dark:divide-zinc-800">
    {posts.map((post) => (
      <article class="py-7 first:pt-0">
        <h2 class="text-xl font-semibold tracking-tight text-stone-950 dark:text-zinc-50"><a class="hover:underline" href={`/blog/${post.id}`}>{post.data.title}</a></h2>
        <p class="mt-2 max-w-2xl text-stone-600 dark:text-zinc-400">{post.data.description}</p>
        <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
          <PostMeta date={post.data.publishedAt} body={post.body ?? ''} />
          <ul class="flex flex-wrap gap-x-3 text-xs text-stone-500 dark:text-zinc-500" aria-label="Tags">
            {post.data.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        </div>
      </article>
    ))}
  </div>
</BaseLayout>

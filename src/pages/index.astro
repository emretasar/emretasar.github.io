---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostMeta from '../components/PostMeta.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getPublishedPosts } from '../lib/blog';
import { siteConfig } from '../lib/site';

const latestPosts = (await getPublishedPosts()).slice(0, 3);
const projects = [
  {
    title: 'UAV Ground Control Systems',
    description: 'Linux-based ground control application development on QGroundControl, with PX4, MAVLink, and software-in-the-loop validation.',
    technologies: ['C++', 'Qt/QML', 'PX4', 'MAVLink'],
  },
  {
    title: 'Embedded Communication Interfaces',
    description: 'Modern C++ interface software for interconnected systems, developed and validated across the full integration lifecycle.',
    technologies: ['C++', 'TCP/IP', 'UDP', 'MIL-STD-1553'],
  },
];
---

<BaseLayout>
  <section class="max-w-2xl">
    <p class="font-mono text-sm text-stone-500 dark:text-zinc-400">Hello, I’m {siteConfig.name}.</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight text-stone-950 sm:text-5xl dark:text-zinc-50">Software engineer working to build dependable systems.</h1>
    <p class="mt-6 text-lg leading-8 text-stone-600 dark:text-zinc-400">I build C++ and Qt applications for embedded, communication, and autonomous systems. I also explore backend technologies and share practical engineering notes from the work.</p>
    <div class="mt-8 flex flex-wrap gap-4 text-sm font-medium">
      <a class="text-stone-950 underline decoration-stone-400 hover:decoration-stone-950 dark:text-zinc-50 dark:decoration-zinc-600 dark:hover:decoration-zinc-50" href="/about">More about me</a>
      <a class="text-stone-950 underline decoration-stone-400 hover:decoration-stone-950 dark:text-zinc-50 dark:decoration-zinc-600 dark:hover:decoration-zinc-50" href="/blog">Read the blog</a>
    </div>
  </section>

  <section class="mt-20" aria-labelledby="projects-heading">
    <div class="flex items-baseline justify-between gap-4">
      <h2 id="projects-heading" class="text-xl font-semibold tracking-tight">Selected work</h2>
      <span class="text-sm text-stone-500 dark:text-zinc-400">Selected professional work</span>
    </div>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {projects.map((project) => <ProjectCard {...project} />)}
    </div>
  </section>

  <section class="mt-20" aria-labelledby="writing-heading">
    <div class="flex items-baseline justify-between gap-4">
      <h2 id="writing-heading" class="text-xl font-semibold tracking-tight">Latest writing</h2>
      <a href="/blog" class="text-sm text-stone-600 hover:text-stone-950 dark:text-zinc-400 dark:hover:text-zinc-50">View all posts</a>
    </div>
    <div class="mt-6 divide-y divide-stone-200 dark:divide-zinc-800">
      {latestPosts.map((post) => (
        <article class="py-5 first:pt-0">
          <h3 class="font-medium tracking-tight"><a class="hover:underline" href={`/blog/${post.id}`}>{post.data.title}</a></h3>
          <p class="mt-1 text-sm text-stone-600 dark:text-zinc-400">{post.data.description}</p>
          <div class="mt-2"><PostMeta date={post.data.publishedAt} body={post.body ?? ''} /></div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
